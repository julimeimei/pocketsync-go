API_ENV=development
API_HTTP_ADDRESS=:8080
API_DATABASE_URL=postgres://pocketsync:pocketsync@localhost:5432/pocketsync?sslmode=disable
API_DATABASE_CONNECT_TIMEOUT=5s
API_DATABASE_PING_TIMEOUT=2s
API_READ_HEADER_TIMEOUT=5s
API_SHUTDOWN_TIMEOUT=10s
API_MAX_REQUEST_BODY_BYTES=1048576
API_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Optional: serve the compiled Flutter web app from this API origin.
API_WEB_DIST_DIR=

POSTGRES_DB=pocketsync
POSTGRES_USER=pocketsync
POSTGRES_PASSWORD=pocketsync
POSTGRES_PORT=5432
